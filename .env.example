# Scientific Library RAG - Environment Variables

# === Application ===
DEBUG=false

# === CORS ===
# Comma-separated list of allowed origins for CORS
CORS_ORIGINS=http://localhost:8501,http://localhost:3690,http://localhost:8888

# === Frontend ===
# API_URL=http://localhost:3690

# === Ollama ===
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=bge-m3
LLM_MODEL=llama3.1:8b

# === GROBID ===
GROBID_URL=http://localhost:8070

# === API Rate Limits (optional) ===
# Add your email for higher rate limits
OPENALEX_EMAIL=your@email.com
UNPAYWALL_EMAIL=your@email.com
SEMANTIC_SCHOLAR_API_KEY=

# === Caching ===
RETRIEVAL_CACHE_TTL=1800
SEMANTIC_CACHE_THRESHOLD=0.95
SEMANTIC_CACHE_ENABLED=true

# === RAG ===
RAG_TOP_K=10
RAG_MAX_CONTEXT_LENGTH=4096

# === Chunking ===
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# === Instagram Content Automation ===
# Scheduler (background draft generation)
CONTENT_SCHEDULER_ENABLED=false        # Set true to auto-generate drafts
CONTENT_SCHEDULER_INTERVAL_MIN=360     # Minutes between drafts (min 15)

# Image generation (Stable Diffusion WebUI / AUTOMATIC1111-compatible)
IMAGE_BASE_URL=http://localhost:7860   # SD WebUI host
IMAGE_WIDTH=1080
IMAGE_HEIGHT=1080
IMAGE_STEPS=28
IMAGE_SAMPLER=DPM++ 2M Karras
IMAGE_CFG_SCALE=6.5
IMAGE_TIMEOUT=180
# IMAGE_MODEL=                         # Optional: SD checkpoint name override

# Instagram Graph API (Business or Creator account)
# Configure these manually after creating your Meta app and long-lived token.
IG_USER_ID=
IG_ACCESS_TOKEN=
IG_PUBLIC_BASE_URL=                    # Public URL where Meta can fetch images
                                       # (e.g. https://your-tunnel.example.com)
